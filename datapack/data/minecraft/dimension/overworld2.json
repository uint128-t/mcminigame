                        "then_run": {
                            "type": "block",
                            "result_state": {
                                "Name": "minecraft:dirt"
                            }
                        }
                    },
                    {
                        "type": "condition",
                        "if_true": {
                            "type": "stone_depth",
                            "offset": 0,
                            "surface_type": "ceiling",
                            "add_surface_depth": true,
                            "secondary_depth_range": 5
                        },
                        "then_run":{
                            "type": "block",
                            "result_state": {
                                "Name": "minecraft:iron_block"
                            }
                        } 
                    }
                ]
            }
        },
        "biome_source": {
            "type": "minecraft:multi_noise",
            "biomes": [
                {
                    "biome": "minecraft:birch_forest",
                    "parameters": {
                        "temperature": 2,
                        "humidity": 2,
                        "continentalness": 2,

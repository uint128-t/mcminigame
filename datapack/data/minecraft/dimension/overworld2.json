{
    "type": "minecraft:overworld",
    "generator": {
        "type": "minecraft:noise",
        "settings": {
            "name": "minecraft:overworld",
            "default_block": {
                "Name": "minecraft:stone"
            },
            "default_fluid": {
                "Name": "minecraft:oak_planks"
            },
            "sea_level": -64,
            "disable_mob_generation": false,
            "aquifers_enabled": false,
            "ore_veins_enabled": true,

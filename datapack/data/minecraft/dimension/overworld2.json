                            "result_state": {
                                "Name": "minecraft:grass_block"
                            }
                        }
                    },
                    {
                        "type": "condition",
                        "if_true": {
                            "type": "stone_depth",
                            "offset": 0,
                            "surface_type": "floor",
                            "add_surface_depth": true,
                            "secondary_depth_range": 1
